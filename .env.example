# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory — required for Nemotron + Cosmos Reasoner
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Pinned NVIDIA models (change only with a ROADMAP note)
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_COMPILE_MODEL=nvidia/nemotron-3-super-120b-a12b
COSMOS_REASONER_MODEL=nvidia/Cosmos3-Super-Reasoner
GROOT_MODEL=nvidia/GR00T-N1.7-3B

# Tavily — used in Phase 4 skill compilation; get the key now
TAVILY_API_KEY=

# Hugging Face — LeRobot datasets + GR00T weights
HF_TOKEN=
HF_USER=

# SO-101 serial ports (from: apprentice robot find-port)
SO101_FOLLOWER_PORT=/dev/ttyACM0
SO101_FOLLOWER_ID=apprentice_follower
SO101_LEADER_PORT=/dev/ttyACM1
SO101_LEADER_ID=apprentice_leader

# OpenCV camera indices (from: apprentice robot cameras)
SO101_FRONT_CAM=0
SO101_WRIST_CAM=2
SO101_CAM_WIDTH=640
SO101_CAM_HEIGHT=480
SO101_CAM_FPS=30

# Canonical Skill 1 language. Do not change between episodes.
SKILL1_INSTRUCTION=put the block in the blue bowl
